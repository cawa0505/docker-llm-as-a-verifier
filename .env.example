# LLM-as-a-Verifier configuration — copy to .env and fill in your backend.
# This file is safe to commit; it contains no real secrets.

# REQUIRED: URL of an OpenAI-compatible backend that returns token-level
# logprobs. Examples:
#   http://host.docker.internal:8080/v1   (llama.cpp on the Docker host)
#   http://localhost:8000/v1               (vLLM)
#   https://api.deepseek.com               (DeepSeek API)
OPENAI_BASE_URL=

# Model name the backend serves (default: qwen3.5-9b)
MODEL_ALIAS=qwen3.5-9b

# API key for the backend (most local servers accept any value or "EMPTY")
OPENAI_API_KEY=EMPTY

# Verifier HTTP service port (default: 8010)
VERIFIER_PORT=8010

# Minimum score to accept a patch (default: 0.8)
VERIFIER_MIN_SCORE=0.8

# Backend request timeout in seconds (default: 300)
VERIFIER_BACKEND_TIMEOUT=300
